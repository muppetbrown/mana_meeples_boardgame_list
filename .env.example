# Mana & Meeples Board Game Library - environment variables
#
# Copy to .env.local (frontend/backend dev) and fill in values.
# Only the REQUIRED block must be set. Everything else has a sensible default
# (see backend/config.py) and is listed here, commented out, for reference.

# ============================================================================
# REQUIRED
# ============================================================================

# PostgreSQL (production) or SQLite (local dev: sqlite:///./app.db)
DATABASE_URL=postgresql://username:password@host:5432/database

# Admin login token.  Generate: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_TOKEN=your-secure-admin-token-here

# Signs the admin JWTs. REQUIRED when ENVIRONMENT=production (the app refuses to start without it).
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=your-secure-session-secret-here

# "production" enables the SESSION_SECRET requirement, JSON logs, and disables localhost CORS origins
ENVIRONMENT=development

# ============================================================================
# SITE / API URLS
# ============================================================================

# Public base URL of this API (absolute URLs, image proxy allow-list)
# PUBLIC_BASE_URL=https://your-api.onrender.com

# Allowed browser origins, comma-separated (defaults to the production site origins)
# CORS_ORIGINS=https://manaandmeeples.co.nz,https://library.manaandmeeples.co.nz

# ============================================================================
# EXTERNAL SERVICES (all optional; features degrade gracefully)
# ============================================================================

# BoardGameGeek API key - without it BGG requests may be rate limited
# BGG_API_KEY=

# Cloudinary image CDN - enabled automatically when all three are set
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# GitHub token + repo, used to trigger/poll the sleeve-fetch workflow (needs `actions` read/write)
# GITHUB_TOKEN=
# GITHUB_REPO_OWNER=muppetbrown
# GITHUB_REPO_NAME=mana_meeples_boardgame_list

# Error tracking
# SENTRY_DSN=

# Redis holds admin-login attempt counters so rate limiting is shared across instances.
# Falls back to in-memory automatically. Not needed for a single instance.
# REDIS_URL=redis://localhost:6379/0
# REDIS_ENABLED=true

# Optional read replica for public (read-only) endpoints
# READ_REPLICA_URL=postgresql://username:password@replica-host:5432/database

# ============================================================================
# TUNING (defaults shown - only set these to change behaviour)
# ============================================================================

# JWT_EXPIRATION_DAYS=7

# Database pool
# DB_POOL_SIZE=15
# DB_MAX_OVERFLOW=20
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=900
# SLOW_QUERY_THRESHOLD_SECONDS=1.0

# Database safety timeouts (seconds; 0 disables). See docs/operations/STUCK_DEPLOY.md
# DB_LOCK_TIMEOUT_SECONDS=10            # app queries give up waiting for a lock
# DB_IDLE_IN_TX_TIMEOUT_SECONDS=60      # DB closes sessions left idle inside a transaction
# MIGRATION_LOCK_TIMEOUT_SECONDS=30     # a blocked migration fails instead of hanging the deploy
# STARTUP_CACHE_WARM_TIMEOUT_SECONDS=20 # cache warm-up can't delay the server opening its port

# Admin login rate limiting
# RATE_LIMIT_ATTEMPTS=5
# RATE_LIMIT_WINDOW=300
# DISABLE_RATE_LIMITING=false   # tests only

# Caching / HTTP client
# CACHE_TTL_SECONDS=30
# CACHE_FRESH_THRESHOLD=0.9
# HTTP_TIMEOUT=30
# HTTP_RETRIES=3

# CI only: silence the missing-ADMIN_TOKEN warning
# SKIP_ADMIN_WARNING=false
